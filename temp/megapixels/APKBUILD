# Contributor: Martijn Braam <martijn@brixit.nl>
# Maintainer: japq7s <japiotr123@proton.me>
pkgname=megapixels
pkgver=2.1.0
pkgrel=101
pkgdesc="GTK+4 camera app for mobile devices"
url="https://gitlab.com/megapixels-org/Megapixels"
arch="all !s390x"
license="GPL-3.0-only"
# Required by postprocess.sh
depends="libraw-tools imagemagick exiftool"
makedepends="
	feedbackd-dev
	glib-dev
	gperf
	gtk4.0-dev
	libdng-dev
	libmegapixels-dev
	libxrandr-dev
	meson
	pulseaudio-dev
	tiff-dev>=4.6.0t
	zbar-dev
	"
source="https://gitlab.com/megapixels-org/Megapixels/-/archive/$pkgver/Megapixels-$pkgver.tar.bz2
	0001-keep-the-camera-settings-and-focus-during-a-capture.patch
	0002-do-not-reset-the-gain-from-the-io-thread.patch
	"
options="!check" # There's no testsuite
builddir="$srcdir/Megapixels-$pkgver"

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

