+
+#include "camss_isp.h"
+
+namespace libcamera {
+
+class CameraSensor;
+class CamssFrames;
+class ControlInfoMap;
+class MediaEntity;
+class MediaLink;
+class PipelineHandler;
+class V4L2VideoDevice;
+
+/*
+ * The pixel line of the VFE that receives the sensor processes the frame on
+ * its way to memory: NV12 is captured straight from the line, there is no
+ * raw buffer. The soft IPA computes the parameters, its statistics come
+ * from the NV12 frames with the parameters that produced them undone.
+ */
+class CamssIspIfe : public CamssIsp
+{
+public:
+	static std::unique_ptr<CamssIspIfe> match(PipelineHandler *pipe,
+						  MediaLink *csidRdiLink,
+						  CameraSensor *sensor,
+						  CamssFrames *frameInfos,
+						  ControlInfoMap *ispControls);
+
+	CamssIspIfe(PipelineHandler *pipe, CameraSensor *sensor,
+		    CamssFrames *frameInfos, ControlInfoMap *ispControls);
+	~CamssIspIfe() override;
+
+	bool isValid() override;
+	bool isInline() const override { return true; }
+	Size getMargins(PixelFormat inputFormat) override;
+
+	StreamConfiguration generateConfiguration(const StreamConfiguration &raw) const override;
+	StreamConfiguration validate(const StreamConfiguration &raw,
+				     const StreamConfiguration &req) const override;
+	int configure(const StreamConfiguration &inputCfg,
+		      const StreamConfiguration &outputCfg,
+		      ControlInfoMap *ispControls) override;
+
+	int allocateBuffers(unsigned int bufferCount) override;
+	void freeBuffers() override;
+	int exportOutputBuffers(const Stream *stream, unsigned int count,
+				std::vector<std::unique_ptr<FrameBuffer>> *buffers) override;
+	void queueBuffers(Request *request, FrameBuffer *input) override;
+
+	void processStats(const uint32_t frame, const uint32_t statsBufferId,
+			  const ControlList &sensorControls) override;
+
+	int start() override;
+	void stop() override;
+
+private:
+	/* What the pixel pipe applied to a frame, to undo it for statistics */
+	struct Applied {
+		RGB<double> gains;
+		double blackLevel;
+		Matrix<float, 3, 3> matrix;
+		std::array<uint8_t, 256> lut;
+	};
+
+	int init(MediaLink *csidRdiLink);
+	void paramsComputed(uint32_t frame);
+	void setIspParams();
+	void setLensControls(const ControlList &lensControls);
+	void parameterBufferReady(FrameBuffer *buffer);
+	void outputReady(FrameBuffer *buffer);
+	void computeStats(const MappedFrameBuffer &frame, const Applied &applied);
+
+	CameraSensor *sensor_;
+	CamssFrames *frameInfos_;
+
+	MediaLink *csidRdiLink_ = nullptr;
+	MediaLink *csidPixLink_ = nullptr;
+	std::unique_ptr<V4L2Subdevice> pix_;
+	std::unique_ptr<V4L2VideoDevice> output_;
+	std::unique_ptr<V4L2VideoDevice> params_;
+
+	SharedMemObject<DebayerParams> sharedParams_;
+	SharedMemObject<SwIspStats> sharedStats_;
+	std::unique_ptr<ipa::soft::IPAProxySoft> ipa_;
+	/* Frames whose parameters the IPA computes, in order */
+	std::queue<uint32_t> pendingParams_;
+
+	std::vector<std::unique_ptr<FrameBuffer>> paramBuffers_;
+	std::map<FrameBuffer *, MappedFrameBuffer> mappedParams_;
+	std::map<uint32_t, Applied> applied_;
+
+	Size size_;
+	unsigned int stride_ = 0;
+	unsigned int outputBufferCount_ = 0;
+};
+
+} /* namespace libcamera */
