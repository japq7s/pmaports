+/*
+ * The pixel line belongs to the VFE whose RDI0 the CSI side picked for the
+ * sensor, and is fed from the same CSI decoder.
+ */
+int CamssIspIfe::init(MediaLink *csidRdiLink)
+{
+	MediaEntity *csid = csidRdiLink->source()->entity();
+	MediaEntity *rdi = csidRdiLink->sink()->entity();
+	MediaDevice *media = csid->device();
+	std::string name = rdi->name();
+
+	if (!isValid())
+		return -ENOMEM;
+
+	/* msm_vfeN_rdi0 -> msm_vfeN_pix, msm_vfeN_params */
+	std::string::size_type pos = name.rfind("_rdi0");
+	if (pos == std::string::npos)
+		return -ENODEV;
+	std::string vfe = name.substr(0, pos);
+
+	MediaEntity *pix = media->getEntityByName(vfe + "_pix");
+	MediaEntity *params = media->getEntityByName(vfe + "_params");
+	if (!pix || !params)
+		return -ENODEV;
+
+	for (const MediaPad *pad : csid->pads()) {
+		for (MediaLink *link : pad->links()) {
+			if (link->sink()->entity() == pix &&
+			    link->sink()->index() == kPixPadSink)
+				csidPixLink_ = link;
+		}
+	}
+
+	const MediaPad *src = pix->getPadByIndex(kPixPadSrc);
+	if (!csidPixLink_ || !src || src->links().empty())
+		return -ENODEV;
+
+	csidRdiLink_ = csidRdiLink;
+
+	pix_ = std::make_unique<V4L2Subdevice>(pix);
+	int ret = pix_->open();
+	if (ret)
+		return ret;
+
+	output_ = std::make_unique<V4L2VideoDevice>(src->links()[0]->sink()->entity());
+	ret = output_->open();
+	if (ret)
+		return ret;
+
+	params_ = std::make_unique<V4L2VideoDevice>(params);
+	ret = params_->open();
+	if (ret)
+		return ret;
+
+	output_->bufferReady.connect(this, &CamssIspIfe::outputReady);
+	params_->bufferReady.connect(this, &CamssIspIfe::parameterBufferReady);
+
+	return 0;
+}
+
+StreamConfiguration CamssIspIfe::generateConfiguration(const StreamConfiguration &raw) const
+{
+	if (!inputFormatToMediaBus.count(raw.pixelFormat)) {
+		LOG(Camss, Warning) << "Unsupported pixel format " << raw.pixelFormat;
+		return {};
+	}
+
+	/* No scaler on the line: NV12 at the sensor output size */
+	std::map<PixelFormat, std::vector<SizeRange>> formats = {
+		{ formats::NV12, { SizeRange(raw.size) } },
+	};
+
+	StreamConfiguration cfg{ StreamFormats{ formats } };
+	cfg.size = raw.size;
+	cfg.pixelFormat = formats::NV12;
+	cfg.bufferCount = kBufferCount;
+
+	return cfg;
+}
+
+StreamConfiguration CamssIspIfe::validate(const StreamConfiguration &raw,
+					  const StreamConfiguration &req) const
+{
+	if (!inputFormatToMediaBus.count(raw.pixelFormat))
+		return {};
+
+	StreamConfiguration cfg;
+	cfg.pixelFormat = formats::NV12;
+	cfg.size = raw.size;
+
+	V4L2DeviceFormat format;
+	format.fourcc = output_->toV4L2PixelFormat(cfg.pixelFormat);
+	format.size = cfg.size;
+
+	int ret = output_->tryFormat(&format);
+	if (ret < 0 || format.size != cfg.size) {
+		LOG(Camss, Error) << "IFE output try format failed";
+		return {};
+	}
+
+	cfg.stride = format.planes[0].bpl;
+	cfg.frameSize = 0;
+	for (unsigned int i = 0; i < format.planesCount; i++)
+		cfg.frameSize += format.planes[i].size;
+	cfg.bufferCount = std::max(kBufferCount, req.bufferCount);
+	cfg.setStream(const_cast<Stream *>(&outStream_));
+
+	return cfg;
+}
+
+int CamssIspIfe::configure(const StreamConfiguration &inputCfg,
+			   const StreamConfiguration &outputCfg,
+			   [[maybe_unused]] ControlInfoMap *ispControls)
+{
+	ipa::soft::IPAConfigInfo configInfo;
+	configInfo.sensorControls = sensor_->controls();
+	if (CameraLens *lens = sensor_->focusLens())
+		configInfo.lensControls = lens->controls();
+
+	int ret = ipa_->configure(configInfo);
+	if (ret < 0)
+		return ret;
+
+	/* The CSI side links the decoder to RDI0; the pixel line takes over */
+	ret = csidRdiLink_->setEnabled(false);
+	if (ret)
+		return ret;
+
+	ret = csidPixLink_->setEnabled(true);
+	if (ret)
+		return ret;
+
+	V4L2SubdeviceFormat format;
+	format.code = inputFormatToMediaBus.at(inputCfg.pixelFormat);
+	format.size = inputCfg.size;
+	ret = pix_->setFormat(kPixPadSink, &format);
+	if (ret)
+		return ret;
+
+	format.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+	format.size = outputCfg.size;
+	ret = pix_->setFormat(kPixPadSrc, &format);
+	if (ret)
+		return ret;
+
+	V4L2DeviceFormat outputFormat;
+	outputFormat.fourcc = output_->toV4L2PixelFormat(outputCfg.pixelFormat);
+	outputFormat.size = outputCfg.size;
+	ret = output_->setFormat(&outputFormat);
+	if (ret)
+		return ret;
+
+	if (outputFormat.size != outputCfg.size ||
+	    outputFormat.planes[0].bpl != outputCfg.stride) {
+		LOG(Camss, Error) << "IFE output format mismatch";
+		return -EINVAL;
+	}
+
+	size_ = outputCfg.size;
+	stride_ = outputFormat.planes[0].bpl;
+	outputBufferCount_ = outputCfg.bufferCount;
+
+	return 0;
+}
+
+int CamssIspIfe::allocateBuffers(unsigned int bufferCount)
+{
+	int ret = output_->importBuffers(outputBufferCount_);
+	if (ret < 0)
+		return ret;
+
+	ret = params_->allocateBuffers(bufferCount, &paramBuffers_);
+	if (ret < 0) {
+		freeBuffers();
+		return ret;
+	}
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : paramBuffers_)
+		mappedParams_.emplace(buffer.get(),
+				      MappedFrameBuffer(buffer.get(),
+							MappedFrameBuffer::MapFlag::ReadWrite));
+
+	frameInfos_->init(paramBuffers_, {}, true);
+
+	return 0;
+}
+
+void CamssIspIfe::freeBuffers()
+{
+	pendingParams_ = {};
+	frameInfos_->clear();
+	mappedParams_.clear();
+	applied_.clear();
+	paramBuffers_.clear();
+	params_->releaseBuffers();
+	output_->releaseBuffers();
+}
