+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Qualcomm CAMSS IFE inline pixel pipe ISP class
+ */
+
+#pragma once
+
+#include <array>
+#include <map>
+#include <memory>
