From dab36fa79a88948170f586aeafb4c1aa96d16acb Mon Sep 17 00:00:00 2001
From: japq7s <japiotr123@proton.me>
Date: Tue, 20 Oct 2026 15:30:33 +0200
Subject: [PATCH 33/34] pipeline: camss: Register the largest sensor first

Applications open the first camera by default, which was the sensor on
the lowest numbered CSI phy: the IMX355 ultra wide on senna, not its
IMX890 main camera. Register the cameras by decreasing array size.

Signed-off-by: japq7s <japiotr123@proton.me>
---
 src/libcamera/pipeline/camss/camss.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/libcamera/pipeline/camss/camss.cpp b/src/libcamera/pipeline/camss/camss.cpp
index 39ac831..8902596 100644
--- a/src/libcamera/pipeline/camss/camss.cpp
+++ b/src/libcamera/pipeline/camss/camss.cpp
@@ -548,6 +548,19 @@ bool PipelineHandlerCamss::match(DeviceEnumerator *enumerator)
 	if (csiCams.empty())
 		return false;
 
+	/*
+	 * Applications open the first camera by default: register the sensor
+	 * with the largest array first, which is the main camera of a phone,
+	 * rather than whatever sits on the lowest numbered CSI phy.
+	 */
+	std::stable_sort(csiCams.begin(), csiCams.end(),
+			 [](const std::unique_ptr<CamssCsiCamera> &a,
+			    const std::unique_ptr<CamssCsiCamera> &b) {
+				 const Size &ra = a->sensor()->resolution();
+				 const Size &rb = b->sensor()->resolution();
+				 return ra.width * ra.height > rb.width * rb.height;
+			 });
+
 	unsigned int numCameras = 0;
 	for (unsigned int i = 0; i < csiCams.size(); i++) {
 		std::unique_ptr<CamssCameraData> data =
