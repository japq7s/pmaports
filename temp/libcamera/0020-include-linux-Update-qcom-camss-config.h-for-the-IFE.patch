From 35cb0870a4181c1e5f26ede717801e20bafa449f Mon Sep 17 00:00:00 2001
From: japq7s <japiotr123@proton.me>
Date: Mon, 19 Oct 2026 18:18:52 +0200
Subject: [PATCH 20/25] include: linux: Update qcom-camss-config.h for the IFE

Sync the parameters part with the kernel uAPI of the CAMSS IFE pixel
path, which adds the AEC Bayer histogram parameters block and sizes the
IFE parameters buffer for the WB, colour correction and gamma blocks it
applies. The statistics blocks are left out: they need a newer
linux/media/v4l2-isp.h than this tree has, and nothing here uses them.

Signed-off-by: japq7s <japiotr123@proton.me>
---
 include/linux/qcom-camss-config.h | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/include/linux/qcom-camss-config.h b/include/linux/qcom-camss-config.h
index aa3d97c..6ca42bc 100644
--- a/include/linux/qcom-camss-config.h
+++ b/include/linux/qcom-camss-config.h
@@ -25,12 +25,15 @@
  *	&struct camss_params_color_correct
  * @CAMSS_PARAMS_GAMMA: per-channel gamma correction curves (CLC_GLUT),
  *	&struct camss_params_gamma
+ * @CAMSS_PARAMS_AEC_BHIST: region of the AEC Bayer histogram statistics,
+ *	&struct camss_params_aec_bhist
  */
 enum camss_params_block_type {
 	CAMSS_PARAMS_WB_GAIN = 1,
 	CAMSS_PARAMS_CHROMA_ENHAN = 2,
 	CAMSS_PARAMS_COLOR_CORRECT = 3,
 	CAMSS_PARAMS_GAMMA = 4,
+	CAMSS_PARAMS_AEC_BHIST = 5,
 };
 
 /* Number of entries in each gamma channel LUT. */
@@ -209,4 +212,32 @@ struct camss_params_gamma {
 	 sizeof(struct camss_params_color_correct)	+\
 	 sizeof(struct camss_params_gamma))
 
+/**
+ * struct camss_params_aec_bhist - AEC Bayer histogram configuration
+ *
+ * Selects the region of the frame the AEC Bayer histogram,
+ * &struct camss_stats_bhist, counts. The region is given in pixels of the
+ * Bayer frame entering the ISP; every value must be even, as the histogram
+ * counts 2x2 Bayer quads. A region reaching past the frame is clipped to it.
+ *
+ * @header: block header; @header.type = CAMSS_PARAMS_AEC_BHIST
+ * @left:   horizontal offset of the region
+ * @top:    vertical offset of the region
+ * @width:  width of the region, at least 2
+ * @height: height of the region, at least 2
+ */
+struct camss_params_aec_bhist {
+	struct v4l2_isp_params_block_header header;
+	__u16 left;
+	__u16 top;
+	__u16 width;
+	__u16 height;
+} __attribute__((aligned(8)));
+
+#define CAMSS_PARAMS_IFE_MAX_PAYLOAD		\
+	(sizeof(struct camss_params_wb_gain)	+\
+	 sizeof(struct camss_params_color_correct)	+\
+	 sizeof(struct camss_params_gamma)	+\
+	 sizeof(struct camss_params_aec_bhist))
+
 #endif /* _UAPI_LINUX_QCOM_CAMSS_CONFIG_H */
-- 
