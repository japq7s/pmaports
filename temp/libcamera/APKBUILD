	0004-ipa-simple-Derive-AGC-minimum-gain-step-from-sensor-.patch
	0005-debayer-Further-demote-Unsupported-input-format-log.patch
	0006-debayer_egl-Use-untransposed-matrix-to-fix-GLES-2.0.patch
	0007-simple-Limit-swISP-output-sizes.patch
	0008-libcamera-Add-quad-Bayer-CFA-layout-support.patch
	0009-ipa-libipa-camera_sensor_helper-Add-IMX890-helper.patch
	0010-libcamera-software_isp-Add-a-focus-measure-to-the-st.patch
	0011-libcamera-simple-Forward-lens-controls-from-the-soft.patch
