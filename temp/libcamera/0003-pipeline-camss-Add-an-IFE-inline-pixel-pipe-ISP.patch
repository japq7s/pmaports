+const std::map<PixelFormat, uint32_t> inputFormatToMediaBus = {
+	{ formats::SBGGR8, MEDIA_BUS_FMT_SBGGR8_1X8 },
+	{ formats::SGBRG8, MEDIA_BUS_FMT_SGBRG8_1X8 },
+	{ formats::SGRBG8, MEDIA_BUS_FMT_SGRBG8_1X8 },
+	{ formats::SRGGB8, MEDIA_BUS_FMT_SRGGB8_1X8 },
+	{ formats::SBGGR10_CSI2P, MEDIA_BUS_FMT_SBGGR10_1X10 },
+	{ formats::SGBRG10_CSI2P, MEDIA_BUS_FMT_SGBRG10_1X10 },
+	{ formats::SGRBG10_CSI2P, MEDIA_BUS_FMT_SGRBG10_1X10 },
+	{ formats::SRGGB10_CSI2P, MEDIA_BUS_FMT_SRGGB10_1X10 },
+};
+
+/* VFE pixel line pads */
+constexpr unsigned int kPixPadSink = 0;
+constexpr unsigned int kPixPadSrc = 1;
+
+/* Statistics sample every kStatsStep pixels of the central 2/3 of the frame */
+constexpr unsigned int kStatsStep = 4;
+
+/* The same curve as DebayerCpu::updateGammaTable() */
+std::array<uint8_t, 256> gammaLut(float gamma, float contrastExp)
+{
+	std::array<uint8_t, 256> lut;
+
+	for (unsigned int i = 0; i < lut.size(); i++) {
+		float x = i / 255.0f;
+
+		if (x < 0.5f)
+			x = 0.5f * std::pow(x / 0.5f, contrastExp);
+		else
+			x = 1.0f - 0.5f * std::pow((1.0f - x) / 0.5f, contrastExp);
+		lut[i] = std::clamp<long>(std::lround(255.0f * std::pow(x, gamma)), 0, 255);
+	}
+
+	return lut;
+}
+
+int16_t ccCoeff(float v)
+{
+	/* 12sQ8 */
+	return std::lround(std::clamp(v, -8.0f, 7.99f) * 256);
+}
+
