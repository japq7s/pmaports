+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Idle,
+		Waiting,
+		CoarseScan,
+		FineScan,
+		Focused,
+		Failed,
+	};
+
+	void moveTo(IPAContext &context, int32_t position);
+	void startScan(IPAContext &context);
+	void waitForStableScene();
+	void scanStep(IPAContext &context, double contrast);
+	void finishScan(IPAContext &context);
+	void monitor(IPAContext &context, double contrast, double mean);
+
+	int32_t toPosition(float dioptres) const;
+	float toDioptres(int32_t position) const;
+
+	/* Tuning */
+	int32_t infinity_ = -1;
+	int32_t macro_ = -1;
+	float macroDioptres_ = 10.0f;
+	unsigned int coarseSteps_ = 12;
+	unsigned int fineSteps_ = 4;
+
+	/* Lens range, from the tuning file or the lens driver */
+	int32_t near_ = 0;
+	int32_t far_ = 0;
+
+	int32_t mode_ = 0;
+	State state_ = State::Idle;
+	int32_t position_ = 0;
+
+	/* Scan */
+	int32_t step_ = 0;
+	int32_t scanEnd_ = 0;
+	int32_t bestPosition_ = 0;
+	double bestContrast_ = 0.0;
+	double minContrast_ = 0.0;
+	double prevContrast_ = 0.0;
+	double nextContrast_ = 0.0;
+	double lastSample_ = 0.0;
+	unsigned int falling_ = 0;
+	unsigned int skip_ = 0;
+
+	/* Scene change detection */
+	bool needReference_ = false;
+	double refContrast_ = 0.0;
+	double refMean_ = 0.0;
+	double lastContrast_ = 0.0;
+	double lastMean_ = 0.0;
+	unsigned int changed_ = 0;
+	unsigned int stable_ = 0;
+	bool changePending_ = false;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
