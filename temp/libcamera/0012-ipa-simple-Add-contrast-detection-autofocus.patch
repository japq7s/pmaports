+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+/**
+ * \class Af
+ * \brief Contrast detection autofocus for the software ISP
+ *
+ * The focus measure comes from the software ISP statistics: the mean squared
+ * difference of horizontally adjacent luminance samples in the centre of the
+ * frame, divided by the squared mean luminance so that it does not depend on
+ * the exposure.
+ *
+ * A scan steps the lens from infinity towards macro in coarse steps until the
+ * measure has clearly passed its peak, then scans around the best coarse
+ * position in fine steps and settles on the interpolated peak.
+ *
+ * In continuous mode the first scan waits until the scene, and the exposure
+ * with it, is stable. The lens is left alone once focused. A new scan only
+ * starts when the scene has changed (focus measure or brightness away from
+ * the values at the end of the scan for several measurements) and has then
+ * become stable again, so that the lens does not hunt while the camera is
+ * moving or because of noise in a dim scene.
+ */
+
+/* Measurements below this fraction of the best one mean the peak is behind. */
+static constexpr double kPeakDrop = 0.85;
+/* Number of falling measurements that end a scan. */
+static constexpr unsigned int kFallingToStop = 2;
+/* A scan whose best measurement is not this much above the worst is flat. */
+static constexpr double kFlatRatio = 1.15;
+
+/* Relative change of the focus measure or brightness that means a new scene. */
+static constexpr double kSceneContrastChange = 0.4;
+static constexpr double kSceneMeanChange = 0.25;
+static constexpr unsigned int kSceneChangedCount = 3;
+/* Relative change between measurements below which the scene is stable. */
+static constexpr double kStableContrast = 0.1;
+static constexpr double kStableMean = 0.05;
+static constexpr unsigned int kStableCount = 3;
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	infinity_ = tuningData["infinity"].get<int32_t>(-1);
+	macro_ = tuningData["macro"].get<int32_t>(-1);
+	macroDioptres_ = tuningData["macroDioptres"].get<float>(10.0f);
+	coarseSteps_ = std::max(tuningData["coarseSteps"].get<uint32_t>(12), 2u);
+	fineSteps_ = std::max(tuningData["fineSteps"].get<uint32_t>(4), 1u);
+
+	if (macroDioptres_ <= 0.0f) {
+		LOG(IPASoftAf, Error) << "macroDioptres must be positive";
+		return -EINVAL;
+	}
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, macroDioptres_, 0.0f);
+
+	mode_ = controls::AfModeContinuous;
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto it = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == configInfo.lensControls.end()) {
+		LOG(IPASoftAf, Warning) << "No focus lens, autofocus disabled";
+		context.configuration.af.enabled = false;
+		return 0;
+	}
+
+	const int32_t min = it->second.min().get<int32_t>();
+	const int32_t max = it->second.max().get<int32_t>();
+
+	far_ = infinity_ >= 0 ? std::clamp(infinity_, min, max) : min;
+	near_ = macro_ >= 0 ? std::clamp(macro_, min, max) : max;
+	if (far_ == near_) {
+		LOG(IPASoftAf, Error) << "Empty focus range " << far_;
+		context.configuration.af.enabled = false;
+		return 0;
+	}
+
+	context.configuration.af.enabled = true;
+	position_ = std::clamp(position_, std::min(far_, near_), std::max(far_, near_));
+	context.activeState.af.lensPosition = position_;
+
+	LOG(IPASoftAf, Debug)
+		<< "Focus range " << far_ << " (infinity) - " << near_
+		<< " (" << macroDioptres_ << " dioptres)";
+
+	if (mode_ == controls::AfModeContinuous)
+		waitForStableScene();
+	else
+		state_ = State::Idle;
+
+	return 0;
+}
+
+void Af::waitForStableScene()
+{
+	/*
+	 * At stream start the exposure is still converging, and a scan taken
+	 * meanwhile measures a changing image. Wait for the scene to settle,
+	 * as after a scene change.
+	 */
+	state_ = State::Waiting;
+	needReference_ = false;
+	changePending_ = true;
+	stable_ = 0;
+	lastContrast_ = 0.0;
+	lastMean_ = 0.0;
+}
+
+void Af::queueRequest(typename Module::Context &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] typename Module::FrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.configuration.af.enabled)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = *mode;
+		if (mode_ == controls::AfModeContinuous)
+			startScan(context);
+		else
+			state_ = State::Idle;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			startScan(context);
+		else if (state_ == State::CoarseScan || state_ == State::FineScan)
+			state_ = State::Idle;
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && mode_ == controls::AfModeManual)
+		moveTo(context, toPosition(*lensPosition));
+}
+
+int32_t Af::toPosition(float dioptres) const
+{
+	double ratio = std::clamp(dioptres / macroDioptres_, 0.0f, 1.0f);
+	return far_ + static_cast<int32_t>(std::lround(ratio * (near_ - far_)));
+}
+
+float Af::toDioptres(int32_t position) const
+{
+	return static_cast<float>(position - far_) / (near_ - far_) * macroDioptres_;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position = std::clamp(position, std::min(far_, near_), std::max(far_, near_));
+
+	/*
+	 * After a jump over several coarse steps the lens may still be moving
+	 * when the next statistics are taken: skip them.
+	 */
+	if (std::abs(position - position_) > 2 * std::abs(near_ - far_) /
+						     static_cast<int32_t>(coarseSteps_))
+		skip_ = std::max(skip_, 1u);
+
+	position_ = position;
+	context.activeState.af.lensPosition = position;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	step_ = (near_ - far_) / static_cast<int32_t>(coarseSteps_);
+	if (!step_)
+		step_ = near_ > far_ ? 1 : -1;
+	scanEnd_ = near_;
+	bestContrast_ = 0.0;
+	minContrast_ = 0.0;
+	bestPosition_ = far_;
+	falling_ = 0;
+	changePending_ = false;
+	changed_ = 0;
+	stable_ = 0;
+	state_ = State::CoarseScan;
+
+	moveTo(context, far_);
+	skip_ = std::max(skip_, 1u);
+
+	LOG(IPASoftAf, Debug) << "Scan started";
+}
+
+void Af::scanStep(IPAContext &context, double contrast)
+{
+	if (contrast > bestContrast_) {
+		bestContrast_ = contrast;
+		bestPosition_ = position_;
+		prevContrast_ = lastSample_;
+		nextContrast_ = 0.0;
+		falling_ = 0;
+	} else {
+		if (position_ == bestPosition_ + step_)
+			nextContrast_ = contrast;
+		falling_ = contrast < bestContrast_ * kPeakDrop ? falling_ + 1 : 0;
+	}
+	if (minContrast_ == 0.0 || contrast < minContrast_)
+		minContrast_ = contrast;
+	lastSample_ = contrast;
+
+	const bool atEnd = (step_ > 0 && position_ + step_ > scanEnd_) ||
+			   (step_ < 0 && position_ + step_ < scanEnd_);
+
+	if (falling_ < kFallingToStop && !atEnd) {
+		moveTo(context, position_ + step_);
+		return;
+	}
+
+	if (state_ == State::CoarseScan) {
+		if (bestContrast_ < minContrast_ * kFlatRatio) {
+			LOG(IPASoftAf, Debug)
+				<< "Scan found no peak (" << minContrast_
+				<< " - " << bestContrast_ << ")";
+			state_ = State::Failed;
+			moveTo(context, far_);
+			needReference_ = true;
+			skip_ = std::max(skip_, 1u);
+			return;
+		}
+
+		/* Scan around the best coarse position in fine steps. */
+		const int32_t coarse = step_;
+		step_ = coarse / static_cast<int32_t>(fineSteps_);
+		if (!step_)
+			step_ = coarse > 0 ? 1 : -1;
+		const int32_t lo = std::min(far_, near_);
+		const int32_t hi = std::max(far_, near_);
+		scanEnd_ = std::clamp(bestPosition_ + coarse, lo, hi);
+		const int32_t start = std::clamp(bestPosition_ - coarse, lo, hi);
+
+		bestContrast_ = 0.0;
+		lastSample_ = 0.0;
+		falling_ = 0;
+		state_ = State::FineScan;
+		moveTo(context, start);
+		skip_ = std::max(skip_, 1u);
+		return;
+	}
+
+	finishScan(context);
+}
+
+void Af::finishScan(IPAContext &context)
+{
+	int32_t position = bestPosition_;
+
+	/* Interpolate the peak from the measurements next to the best one. */
+	const double a = prevContrast_;
+	const double b = bestContrast_;
+	const double c = nextContrast_;
+	const double denominator = a - 2.0 * b + c;
+	if (a > 0.0 && c > 0.0 && denominator < 0.0) {
+		double offset = 0.5 * (a - c) / denominator;
+		offset = std::clamp(offset, -0.5, 0.5);
+		position += static_cast<int32_t>(std::lround(offset * step_));
+	}
+
+	LOG(IPASoftAf, Debug)
+		<< "Focused at " << position << " (best " << bestPosition_
+		<< ", measure " << bestContrast_ << ")";
+
+	state_ = State::Focused;
+	moveTo(context, position);
+	needReference_ = true;
+	skip_ = std::max(skip_, 1u);
+}
+
+void Af::monitor(IPAContext &context, double contrast, double mean)
+{
+	if (needReference_) {
+		refContrast_ = contrast;
+		refMean_ = mean;
+		lastContrast_ = contrast;
+		lastMean_ = mean;
+		needReference_ = false;
+		changed_ = 0;
+		stable_ = 0;
+		changePending_ = false;
+		return;
+	}
+
+	const auto relative = [](double value, double reference) {
+		return reference > 0.0 ? std::abs(value / reference - 1.0) : 1.0;
+	};
+
+	if (!changePending_) {
+		if (relative(contrast, refContrast_) > kSceneContrastChange ||
+		    relative(mean, refMean_) > kSceneMeanChange)
+			changed_++;
+		else
+			changed_ = 0;
+
+		if (changed_ >= kSceneChangedCount) {
+			changePending_ = true;
+			stable_ = 0;
+			LOG(IPASoftAf, Debug) << "Scene changed";
+		}
+	} else {
+		if (relative(contrast, lastContrast_) < kStableContrast &&
+		    relative(mean, lastMean_) < kStableMean)
+			stable_++;
+		else
+			stable_ = 0;
+
+		if (stable_ >= kStableCount && mode_ == controls::AfModeContinuous)
+			startScan(context);
+	}
+
+	lastContrast_ = contrast;
+	lastMean_ = mean;
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.configuration.af.enabled)
+		return;
+
+	int32_t afState = controls::AfStateIdle;
+	if (mode_ != controls::AfModeManual) {
+		switch (state_) {
+		case State::Waiting:
+		case State::CoarseScan:
+		case State::FineScan:
+			afState = controls::AfStateScanning;
+			break;
+		case State::Focused:
+			afState = controls::AfStateFocused;
+			break;
+		case State::Failed:
+			afState = controls::AfStateFailed;
+			break;
+		case State::Idle:
+			break;
+		}
+	}
+	metadata.set(controls::AfState, afState);
+	metadata.set(controls::LensPosition, toDioptres(position_));
+
+	if (!stats->valid || !stats->focusCount)
+		return;
+
+	if (skip_) {
+		skip_--;
+		return;
+	}
+
+	const double mean = static_cast<double>(stats->focusSum) / stats->focusCount;
+	const double contrast = static_cast<double>(stats->focusSquares) /
+				stats->focusCount / (mean * mean + 1.0);
+
+	switch (state_) {
+	case State::CoarseScan:
+	case State::FineScan:
+		scanStep(context, contrast);
+		break;
+	case State::Waiting:
+	case State::Focused:
+	case State::Failed:
+		monitor(context, contrast, mean);
+		break;
+	case State::Idle:
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
