From d0bf200568e31300f0b15a25c00c7fa09c275a91 Mon Sep 17 00:00:00 2001
From: japq7s <japiotr123@proton.me>
Date: Thu, 15 Oct 2026 15:03:25 +0200
Subject: [PATCH 09/27] ipa: libipa: camera_sensor_helper: Add IMX890 helper

Add a camera sensor helper for the Sony IMX890. The driver exposes the
analogue gain linearly in 1/256 steps, and the black level of 64 at 10 bits
was measured on raw frames from a realme GT Neo5.

Signed-off-by: japq7s <japiotr123@proton.me>
---
 src/ipa/libipa/camera_sensor_helper.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 9457d62..82b1337 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -665,6 +665,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx708", CameraSensorHelperImx708)
 
+class CameraSensorHelperImx890 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx890()
+	{
+		/* From dark frame measurement: 0x40 at 10bits. */
+		blackLevel_ = 4096;
+		/* The driver control is linear, 256 = 1x. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx890", CameraSensorHelperImx890)
+
 class CameraSensorHelperOv01a10 : public CameraSensorHelper
 {
 public:
