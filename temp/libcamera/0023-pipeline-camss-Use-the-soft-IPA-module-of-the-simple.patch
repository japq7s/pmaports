From bf01eae5bb69134ea42669eb8abeed5739717c17 Mon Sep 17 00:00:00 2001
From: japq7s <japiotr123@proton.me>
Date: Mon, 19 Oct 2026 18:28:36 +0200
Subject: [PATCH 23/28] pipeline: camss: Use the soft IPA module of the simple
 pipeline handler

On v0.7.2 the soft IPA module is the simple pipeline handler's, which
the camss pipeline handler did not match: both the IFE and the software
ISP failed with "Creating IPA failed" and no camera was registered.

Signed-off-by: japq7s <japiotr123@proton.me>
---
 src/libcamera/pipeline/camss/camss.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/libcamera/pipeline/camss/camss.cpp b/src/libcamera/pipeline/camss/camss.cpp
index 8c1831d..7309832 100644
--- a/src/libcamera/pipeline/camss/camss.cpp
+++ b/src/libcamera/pipeline/camss/camss.cpp
@@ -298,6 +298,8 @@ PipelineHandlerCamss::PipelineHandlerCamss(CameraManager *manager)
 	: PipelineHandler(manager), csi_()
 {
 	lockOnAcquire_ = false;
+	/* The soft IPA module is the simple pipeline handler's */
+	ipaName_ = "simple";
 }
 
 std::unique_ptr<CameraConfiguration>
-- 
2.55.0

