+	constexpr unsigned int zx = SwIspStats::kFocusZonesX;
+	constexpr unsigned int zy = SwIspStats::kFocusZonesY;
+	const unsigned int gx0 = size_.width / 10, gw = size_.width * 8 / 10;
+	const unsigned int gy0 = size_.height / 10, gh = size_.height * 8 / 10;
+	for (unsigned int r = 0; r < zy; r++) {
+		for (unsigned int c = 0; c < zx; c++) {
+			SwIspStats::FocusZone &zone = stats.focusZones[r * zx + c];
+			const unsigned int fx0 = gx0 + gw * c / zx, fx1 = gx0 + gw * (c + 1) / zx;
+			const unsigned int fy0 = gy0 + gh * r / zy, fy1 = gy0 + gh * (r + 1) / zy;
+
+			for (unsigned int row = fy0; row < fy1; row += kStatsStep) {
+				const uint8_t *yl = &y[row * stride];
+				int64_t prev = -1;
+
+				for (unsigned int col = fx0 & ~1u; col < fx1; col += 2) {
+					int64_t cur = yl[col];
+
+					if (prev >= 0)
