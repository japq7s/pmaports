+/* Scan around the best coarse position in fine steps. */
+void Af::startFineScan(IPAContext &context)
+{
+	const int32_t coarse = step_;
+	step_ = coarse / static_cast<int32_t>(fineSteps_);
+	if (!step_)
+		step_ = coarse > 0 ? 1 : -1;
+	const int32_t lo = std::min(far_, near_);
+	const int32_t hi = std::max(far_, near_);
+	scanEnd_ = std::clamp(bestPosition_ + coarse, lo, hi);
+	const int32_t start = std::clamp(bestPosition_ - coarse, lo, hi);
+
+	bestContrast_ = 0.0;
+	lastSample_ = 0.0;
+	falling_ = 0;
+	state_ = State::FineScan;
+	moveTo(context, start);
+	skip_ = std::max(skip_, 1u);
+}
+
+bool Af::zoneMeasures(const SwIspStats *stats, ZoneMeasures *measures)
+{
+	for (unsigned int z = 0; z < SwIspStats::kFocusZones; z++) {
+		const SwIspStats::FocusZone &zone = stats->focusZones[z];
+
+		if (!zone.count)
+			return false;
+
+		const double mean = static_cast<double>(zone.sum) / zone.count;
+		(*measures)[z] = static_cast<double>(zone.squares) / zone.count /
+				 (mean * mean + 1.0);
+	}
+
+	return true;
+}
+
+/* Returns kFocusZones when no zone has a clear peak */
+unsigned int Af::pickZone() const
+{
+	const unsigned int n = coarseMeasures_.size();
+	std::array<double, SwIspStats::kFocusZones> score{};
+	std::array<unsigned int, SwIspStats::kFocusZones> peak{};
+	double best = 0.0;
+
+	for (unsigned int z = 0; z < SwIspStats::kFocusZones; z++) {
+		double hi = 0.0, lo = 0.0;
+
+		for (unsigned int i = 0; i < n; i++) {
+			const double v = coarseMeasures_[i][z];
+
+			if (v > hi) {
+				hi = v;
+				peak[z] = i;
+			}
+			if (i == 0 || v < lo)
+				lo = v;
+		}
+
+		if (lo <= 0.0 || hi < lo * kFlatRatio)
+			continue;
+
+		score[z] = std::log(hi / lo);
+		if (z == SwIspStats::kFocusZones / 2)
+			score[z] *= kCentreWeight;
+		best = std::max(best, score[z]);
+	}
+
+	unsigned int chosen = SwIspStats::kFocusZones;
+	for (unsigned int z = 0; z < SwIspStats::kFocusZones; z++) {
+		if (best <= 0.0 || score[z] < best * kZoneShare)
+			continue;
+
+		/* The scan runs from infinity to macro: later is nearer. */
+		if (chosen == SwIspStats::kFocusZones || peak[z] > peak[chosen] ||
+		    (peak[z] == peak[chosen] && score[z] > score[chosen]))
+			chosen = z;
+	}
+
+	return chosen;
+}
+
+/* The coarse scan over the whole range, every zone recorded */
+void Af::coarseZoneStep(IPAContext &context, const ZoneMeasures &measures)
+{
+	coarsePositions_.push_back(position_);
+	coarseMeasures_.push_back(measures);
+
+	const bool atEnd = (step_ > 0 && position_ + step_ > scanEnd_) ||
+			   (step_ < 0 && position_ + step_ < scanEnd_);
+	if (!atEnd) {
+		moveTo(context, position_ + step_);
+		return;
+	}
+
+	zone_ = pickZone();
+	if (zone_ == SwIspStats::kFocusZones) {
+		LOG(IPASoftAf, Debug) << "Scan found no peak in any zone";
+		zone_ = SwIspStats::kFocusZones / 2;
+		state_ = State::Failed;
+		moveTo(context, far_);
+		needReference_ = true;
+		skip_ = std::max(skip_, 1u);
+		return;
+	}
+
+	const unsigned int n = coarseMeasures_.size();
+	unsigned int i = 0;
+	for (unsigned int j = 1; j < n; j++)
+		if (coarseMeasures_[j][zone_] > coarseMeasures_[i][zone_])
+			i = j;
+
+	bestPosition_ = coarsePositions_[i];
+	bestContrast_ = coarseMeasures_[i][zone_];
+
+	LOG(IPASoftAf, Debug)
+		<< "Focus zone " << zone_ << ", coarse peak at " << bestPosition_;
+
+	startFineScan(context);
+}
+
 void Af::finishScan(IPAContext &context)
 {
 	int32_t position = bestPosition_;
@@ -380,14 +499,33 @@ void Af::process(IPAContext &context,
 		return;
 	}
 
-	const double mean = static_cast<double>(stats->focusSum) / stats->focusCount;
-	const double contrast = static_cast<double>(stats->focusSquares) /
-				stats->focusCount / (mean * mean + 1.0);
+	double mean = static_cast<double>(stats->focusSum) / stats->focusCount;
+	double contrast = static_cast<double>(stats->focusSquares) /
+			  stats->focusCount / (mean * mean + 1.0);
+
+	ZoneMeasures zones;
+	useZones_ = zoneMeasures(stats, &zones);
+	if (useZones_) {
+		/* Scene changes anywhere in the grid restart the focus. */
+		uint64_t squares = 0, sum = 0, count = 0;
+		for (const SwIspStats::FocusZone &zone : stats->focusZones) {
+			squares += zone.squares;
+			sum += zone.sum;
+			count += zone.count;
+		}
+		mean = static_cast<double>(sum) / count;
+		contrast = static_cast<double>(squares) / count / (mean * mean + 1.0);
+	}
 
 	switch (state_) {
 	case State::CoarseScan:
+		if (useZones_)
+			coarseZoneStep(context, zones);
+		else
+			scanStep(context, contrast);
+		break;
 	case State::FineScan:
-		scanStep(context, contrast);
+		scanStep(context, useZones_ ? zones[zone_] : contrast);
 		break;
 	case State::Waiting:
 	case State::Focused:
