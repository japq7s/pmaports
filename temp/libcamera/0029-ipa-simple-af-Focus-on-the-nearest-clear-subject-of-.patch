index 35232a6..187b546 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -56,6 +56,26 @@ struct SwIspStats {
 	 * \brief Number of luminance samples in the focus window
 	 */
 	uint32_t focusCount;
+	/**
+	 * \brief Number of focus zones, a grid over the centre of the frame
+	 */
+	static constexpr unsigned int kFocusZonesX = 3;
+	static constexpr unsigned int kFocusZonesY = 3;
+	static constexpr unsigned int kFocusZones = kFocusZonesX * kFocusZonesY;
+	/**
+	 * \brief The focus measure of one zone, as focusSquares, focusSum and
+	 * focusCount for the focus window
+	 */
+	struct FocusZone {
+		uint64_t squares;
+		uint64_t sum;
+		uint32_t count;
+	};
+	/**
+	 * \brief The focus zones in raster order, all counts zero when the
+	 * statistics have none
+	 */
+	std::array<FocusZone, kFocusZones> focusZones;
 };
 
 } /* namespace libcamera */
