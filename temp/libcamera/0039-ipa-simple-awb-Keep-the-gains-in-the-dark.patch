From f4b342a4ba148281f04a714fdb4870e393e3c9ba Mon Sep 17 00:00:00 2001
From: japq7s <japiotr123@proton.me>
Date: Wed, 21 Oct 2026 22:50:58 +0200
Subject: [PATCH 39/40] ipa: simple: awb: Keep the gains in the dark

With the lens covered the sums above the black level are noise and the
grey world gains came out as anything: 0.0005 for red was measured on
an IMX890 lying on a desk, and the colours were wrong for a while after
the light came back.

Do not update the gains while the mean green is less than two 8 bit
levels above black.

Signed-off-by: japq7s <japiotr123@proton.me>
---
 src/ipa/simple/algorithms/awb.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 05155c8..c519ac4 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -23,6 +23,9 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+/* Minimum of the mean green, in 8 bit levels above black, for AWB to update */
+static constexpr uint64_t kMinMeanGreen = 2;
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
@@ -73,6 +76,17 @@ void Awb::process(IPAContext &context,
 	 */
 	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
 
+	/*
+	 * In the dark (the lens covered) the sums above the black level are
+	 * noise: the gains came out at 0.0005 for red and the colours stayed
+	 * wrong for a while after the light came back. Keep the last gains
+	 * unless the mean green is at least kMinMeanGreen levels above black.
+	 */
+	if (sum.g() < nPixels * kMinMeanGreen) {
+		LOG(IPASoftAwb, Debug) << "Too dark, gains kept";
+		return;
+	}
+
 	/*
 	 * Calculate red and blue gains for AWB.
 	 * Clamp max gain at 4.0, this also avoids 0 division.
-- 
