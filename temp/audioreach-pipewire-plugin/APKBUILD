e4fafbe9ac4b6bb2ea842b2cb9943a1ac5b0082523e708192d8bce27f266e9460d566fa189da189c9b48d78d157a5fdadd03e0c567866645aa31d8a52ae7fb1d  0001-pw-pal-plugin-add-a-card-with-a-voice-call-profile.patch
