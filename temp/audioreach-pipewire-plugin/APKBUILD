# Maintainer: japq7s <japiotr123@proton.me>
pkgname=audioreach-pipewire-plugin
pkgver=1.0.2_git20260929
pkgrel=0
_commit="5bf590fe160af6b37247fbe29a5d6941d791271d"
pkgdesc="PipeWire module-pal: PipeWire sinks/sources and a voice call card on top of AudioReach PAL"
url="https://github.com/AudioReach/audioreach-pipewire-plugin"
arch="aarch64"
license="BSD-3-Clause"
depends="pipewire audioreach-pal"
makedepends="autoconf automake libtool linux-headers expat-dev pipewire-dev
	tinyalsa-dev>=2.0.0_git audioreach-pal-dev audioreach-graphmgr-dev"
source="
	$pkgname-$_commit.tar.gz::https://github.com/AudioReach/audioreach-pipewire-plugin/archive/$_commit.tar.gz
	0001-pw-pal-plugin-add-a-card-with-a-voice-call-profile.patch
"
builddir="$srcdir/audioreach-pipewire-plugin-$_commit"
options="!check"

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc
	make
}

package() {
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	rm -rf "$pkgdir"/usr/lib/pkgconfig

	# The upstream configuration loads sinks/sources for a reference board
	# (headset, DP/HDMI, voice activation) and switches WirePlumber's
	# defaults on headset jack events. Devices ship their own module list.
	mkdir -p "$pkgdir"/usr/share/doc/$pkgname
	mv "$pkgdir"/usr/share/pipewire/pipewire.conf.d/pw-pal-plugin.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/*.conf \
		"$pkgdir"/usr/share/wireplumber/scripts/90-device-detection.lua \
		"$pkgdir"/usr/share/doc/$pkgname/
	rmdir "$pkgdir"/usr/share/pipewire/pipewire.conf.d \
		"$pkgdir"/usr/share/pipewire \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d \
		"$pkgdir"/usr/share/wireplumber/scripts \
		"$pkgdir"/usr/share/wireplumber
}

