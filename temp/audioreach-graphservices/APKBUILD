# Maintainer: japq7s <japiotr123@proton.me>
pkgname=audioreach-graphservices
pkgver=1.0.1_git20261005
pkgrel=1
_commit="3094583c726710b66eb0204fc5d6a7b336d9e575"
pkgdesc="AudioReach graph services: GSL, ACDB manager, GPR, ATS"
url="https://github.com/AudioReach/audioreach-graphservices"
arch="aarch64"
license="BSD-3-Clause"
depends=""
makedepends="autoconf automake libtool linux-headers glib-dev"
subpackages="$pkgname-dev"
source="
	$pkgname-$_commit.tar.gz::https://github.com/AudioReach/audioreach-graphservices/archive/$_commit.tar.gz
	musl-compat.h
	0001-shmem-phy-fall-back-to-mainline-dma-heaps.patch
	msm_audio.h
"
builddir="$srcdir/audioreach-graphservices-$_commit"
options="!check"

prepare() {
	default_prepare
	# -D__unused=... breaks musl headers (struct stat member); musl-compat.h
	# defines it after <sys/stat.h> instead
	find . \( -name Makefile.am -o -name configure.ac \) -exec \
		sed -i 's/-D__unused=__attribute__\\(\\(__unused__\\)\\)//' {} +
	autoreconf -fi
}

build() {
	# uapi of the out-of-tree audioreach-kernel msm_audio_mem driver
	mkdir -p "$srcdir"/inc/linux
	cp "$srcdir"/msm_audio.h "$srcdir"/inc/linux/
	export CPPFLAGS="$CPPFLAGS -I$srcdir/inc"
	export CFLAGS="$CFLAGS -include $srcdir/musl-compat.h"
	export CXXFLAGS="$CXXFLAGS -include $srcdir/musl-compat.h"
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--with-syslog --with-glib --without-cutils --with-audio_dma_support
	make
}

package() {
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
}
