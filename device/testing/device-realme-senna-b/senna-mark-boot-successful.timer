[Unit]
Description=Mark the booted A/B slot successful once the system has been up for a while

[Timer]
# Like Android after boot completed: a kernel that resets or hangs early
# keeps the retry count going down, so the bootloader can still fall back.
# Not much later than a full boot: every reboot before the timer fires costs
# a retry, and a few quick reboots in a row would switch the slot.
OnBootSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
