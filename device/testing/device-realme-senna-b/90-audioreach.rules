# AudioReach userspace (AGM/PAL inside the user's PulseAudio or PipeWire)
# needs the GPR passthrough, the SMMU mapping node and the system DMA-BUF heap.
KERNEL=="aud_pasthru_adsp|msm_audio_mem", GROUP="audio", MODE="0660"
SUBSYSTEM=="dma_heap", KERNEL=="system", GROUP="audio", MODE="0660"
# Card 0 is driven by AGM/PAL (module-pal-card, module-pal), not by
# module-udev-detect or the PipeWire ALSA monitor.
SUBSYSTEM=="sound", ATTRS{id}=="SM8475realmesen", ENV{PULSE_IGNORE}="1", ENV{ACP_IGNORE}="1"
