# Maintainer: japq7s <japiotr123@proton.me>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-realme-senna-b
pkgdesc="Realme GT Neo5 150W"
pkgver=0.1
pkgrel=32
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# qbootctl is deliberately not used: on this device it misreads the active
# slot under mainline and "qbootctl -s" left the bootloader unable to load
# any image. Switch slots with "fastboot --set-active" only.
depends="
	firmware-realme-senna-b
	linux-firmware-ath11k
	linux-firmware-qca
	bootmac
	linux-postmarketos-qcom-sm8450
	make-dynpart-mappings
	mesa-dri-gallium
	calls
	mkbootimg
	android-tools
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	rmtfs
	tqftpserv
	audioreach-pal
	audioreach-graphmgr
	fastrpc
	fastrpc-systemd
	fastrpc-udev
	hexagonrpcd
	hexagonrpcd-systemd
	hexagonrpcd-udev
	libssc
	python3
"
makedepends="devicepkg-dev"
# The PAL nodes live in the sound server: one subpackage per audio backend,
# pulled in by the backend chosen for postmarketos-base-ui.
subpackages="
	$pkgname-pulseaudio:_pulseaudio
	$pkgname-pipewire:_pipewire
"
# AudioReach board configuration replaces the reference files of these
replaces="audioreach-conf audioreach-graphmgr audioreach-pal"
source="
	deviceinfo
	modules-initfs
	90-senna-gpu-nopm.rules
	90-senna-wlan-l1ss.rules
	senna-wlan-l1ss
	msm-modem-uim-selection-retry.conf
	senna-modem-sim-recover
	senna-modem-system-sleep
	phoc.ini
	90-audioreach.rules
	audioreach-blacklist.conf
	adsprpcd_audiopd-senna.conf
	pulseaudio-pal.pa
	pulseaudio-daemon-senna.conf
	pipewire-pal.conf
	wireplumber-senna.conf
	61-senna-fastrpc-sdsp.rules
	81-libssc-senna.rules
	80-senna.preset
	senna-mark-boot-successful
	senna-mark-boot-successful.service
	senna-mark-boot-successful.timer
	senna-sensors-setup
	senna-sensors-setup.service
	hexagonrpcd-sdsp-senna.conf
	sns_reg.conf
	senna-ois
	senna-ois.service
	self_ois.ocfg
	senna-voice-volume
	audio-pal-card.conf
	audio-backend_conf.xml
	audio-card-defs.xml
	audio-mixer_paths_SM8475_realme_senna.xml
	audio-plugin_manager.xml
	audio-resourcemanager_SM8475_realme_senna.xml
	audio-usecaseKvManager.xml
	oplus-chg-blacklist.conf
	oplus-chg-modules-load.conf
	wake-alarm.conf
	72-senna-haptics.rules
	senna-touch-blacklist.conf
	libcamera-imx355.yaml
	libcamera-imx890.yaml
	millipixels.ini
	megapixels.conf
	megapixels-Rear.dcp
	megapixels-Wide.dcp
	megapixels-postprocess.sh
	72-senna-flash.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# A/B: mark the booted slot successful (the bootloader falls back to the
	# other slot after 7 unmarked boots). Never qbootctl on this device.
	install -Dm755 "$srcdir"/senna-mark-boot-successful \
		"$pkgdir"/usr/libexec/senna-mark-boot-successful
	install -Dm644 "$srcdir"/senna-mark-boot-successful.service \
		"$pkgdir"/usr/lib/systemd/system/senna-mark-boot-successful.service
	install -Dm644 "$srcdir"/senna-mark-boot-successful.timer \
		"$pkgdir"/usr/lib/systemd/system/senna-mark-boot-successful.timer

	# Sensors on the SLPI: hexagonrpcd-sdsp serves the files the SSC reads,
	# libssc + iio-sensor-proxy talk to it.
	install -Dm644 "$srcdir"/61-senna-fastrpc-sdsp.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-senna-fastrpc-sdsp.rules
	install -Dm644 "$srcdir"/81-libssc-senna.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-senna.rules
	install -Dm644 "$srcdir"/80-senna.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-senna.preset
	install -Dm755 "$srcdir"/senna-sensors-setup \
		"$pkgdir"/usr/libexec/senna-sensors-setup
	install -Dm644 "$srcdir"/senna-sensors-setup.service \
		"$pkgdir"/usr/lib/systemd/system/senna-sensors-setup.service
	install -Dm644 "$srcdir"/hexagonrpcd-sdsp-senna.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/senna.conf
	# hexagonrpcd looks its files up by SoC, model vendor and compatible.
	local _hfs="$pkgdir"/usr/share/qcom/sm8475/realme/senna-b
	install -Dm644 "$srcdir"/sns_reg.conf "$_hfs"/sensors/sns_reg.conf
	# Main camera OIS runs on the SLPI: it reads /odm/etc/camera/self_ois.ocfg
	# (hexagonrpcd maps it to camera/) and is started by senna-ois.
	install -Dm644 "$srcdir"/self_ois.ocfg "$_hfs"/camera/self_ois.ocfg
	install -Dm755 "$srcdir"/senna-ois "$pkgdir"/usr/libexec/senna-ois
	install -Dm644 "$srcdir"/senna-ois.service \
		"$pkgdir"/usr/lib/systemd/system/senna-ois.service
	mkdir -p "$_hfs"/acdb "$_hfs"/dsp "$_hfs"/socinfo
	ln -s /var/lib/senna-sensors/registry "$_hfs"/sensors/registry
	ln -s /var/lib/senna-sensors/sdsp "$_hfs"/dsp/sdsp
	# board-id 0x10008 (MTP), SM8475 soc_id 530
	echo MTP > "$_hfs"/socinfo/hw_platform
	echo Unknown > "$_hfs"/socinfo/platform_subtype
	echo 0 > "$_hfs"/socinfo/platform_subtype_id
	echo 65536 > "$_hfs"/socinfo/platform_version
	echo 530 > "$_hfs"/socinfo/soc_id
	echo 1.0 > "$_hfs"/socinfo/revision

	install -Dm644 "$srcdir"/90-senna-gpu-nopm.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-senna-gpu-nopm.rules
	install -Dm644 "$srcdir"/90-senna-wlan-l1ss.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-senna-wlan-l1ss.rules
	install -Dm755 "$srcdir"/senna-wlan-l1ss \
		"$pkgdir"/usr/libexec/senna-wlan-l1ss
	install -Dm644 "$srcdir"/msm-modem-uim-selection-retry.conf \
		"$pkgdir"/usr/lib/systemd/system/msm-modem-uim-selection.service.d/retry.conf
	install -Dm755 "$srcdir"/senna-modem-sim-recover \
		"$pkgdir"/usr/libexec/senna-modem-sim-recover
	install -Dm755 "$srcdir"/senna-modem-system-sleep \
		"$pkgdir"/usr/lib/systemd/system-sleep/senna-modem
	install -Dm644 "$srcdir"/phoc.ini "$pkgdir"/etc/phosh/phoc.ini
	install -Dm644 "$srcdir"/wake-alarm.conf \
		"$pkgdir"/usr/lib/systemd/system/user@.service.d/90-wake-alarm.conf
	install -Dm644 "$srcdir"/wake-alarm.conf \
		"$pkgdir"/usr/lib/systemd/user/plasma-powerdevil.service.d/90-wake-alarm.conf
	install -Dm644 "$srcdir"/72-senna-haptics.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-senna-haptics.rules
	install -Dm644 "$srcdir"/senna-touch-blacklist.conf \
		"$pkgdir"/usr/lib/modprobe.d/senna-touch.conf
	# Ultra wide camera: soft ISP tuning with the stock module CCMs; /etc
	# takes precedence over the generic file shipped by libcamera-ipa.
	install -Dm644 "$srcdir"/libcamera-imx355.yaml \
		"$pkgdir"/etc/libcamera/ipa/simple/imx355.yaml
	install -Dm644 "$srcdir"/libcamera-imx890.yaml \
		"$pkgdir"/etc/libcamera/ipa/simple/imx890.yaml
	# Millipixels looks its camera config up by the DT compatible.
	install -Dm644 "$srcdir"/millipixels.ini \
		"$pkgdir"/usr/share/millipixels/config/realme,senna-b.ini
	install -Dm644 "$srcdir"/megapixels.conf \
		"$pkgdir"/usr/share/megapixels/config/realme,senna-b.conf
	install -Dm755 "$srcdir"/megapixels-postprocess.sh \
		"$pkgdir"/etc/megapixels/postprocess.sh
	# Colour calibration (stock CCMs) and preview gamma, by camera name.
	local _cam
	for _cam in Rear Wide; do
		install -Dm644 "$srcdir"/megapixels-$_cam.dcp \
			"$pkgdir"/usr/share/megapixels/config/realme,senna-b,$_cam.dcp
	done
	# Megapixels fires the flash through flash_strobe of the LED.
	install -Dm644 "$srcdir"/72-senna-flash.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-senna-flash.rules

	# Audio: Qualcomm AudioReach (PAL/AGM/GSL) instead of the upstream
	# q6apm ASoC stack (ACDB calibration: firmware-realme-senna-b). Use-case data come from the stock
	# ODM/vendor partitions (lineage-24.0-20261007); the 24-bit formats of
	# the TFA9874 link and the TX codec DMA are reduced to the 16 bit the
	# mainline drivers accept, and the SoundWire mic channels follow the
	# fixed mainline WCD9385 mapping (ADC1..4 = SWR_MIC0..3).
	install -Dm644 "$srcdir"/90-audioreach.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-audioreach.rules
	install -Dm644 "$srcdir"/audioreach-blacklist.conf \
		"$pkgdir"/usr/lib/modprobe.d/audioreach-blacklist.conf
	install -Dm644 "$srcdir"/adsprpcd_audiopd-senna.conf \
		"$pkgdir"/usr/lib/systemd/system/adsprpcd_audiopd.service.d/senna.conf
	install -Dm644 "$srcdir"/pulseaudio-pal.pa \
		"$pkgdir"/etc/pulse/default.pa.d/senna-pal.pa
	install -Dm644 "$srcdir"/pulseaudio-daemon-senna.conf \
		"$pkgdir"/etc/pulse/daemon.conf.d/90-senna.conf
	install -Dm644 "$srcdir"/audio-pal-card.conf \
		"$pkgdir"/etc/pulse/pal/default.conf
	install -Dm755 "$srcdir"/senna-voice-volume \
		"$pkgdir"/usr/bin/senna-voice-volume
	install -Dm644 "$srcdir"/pipewire-pal.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/90-senna-pal.conf
	install -Dm644 "$srcdir"/wireplumber-senna.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/90-senna.conf

	install -Dm644 "$srcdir"/audio-backend_conf.xml "$pkgdir"/etc/backend_conf.xml
	install -Dm644 "$srcdir"/audio-card-defs.xml "$pkgdir"/etc/card-defs.xml
	install -Dm644 "$srcdir"/audio-plugin_manager.xml "$pkgdir"/etc/plugin_manager.xml
	install -Dm644 "$srcdir"/audio-usecaseKvManager.xml "$pkgdir"/etc/usecaseKvManager.xml
	install -Dm644 "$srcdir"/audio-mixer_paths_SM8475_realme_senna.xml \
		"$pkgdir"/etc/mixer_paths_SM8475_realme_senna.xml
	install -Dm644 "$srcdir"/audio-resourcemanager_SM8475_realme_senna.xml \
		"$pkgdir"/etc/resourcemanager_SM8475_realme_senna.xml

	# Charging: oplus_chg (kernel package) instead of qcom_battmgr
	install -Dm644 "$srcdir"/oplus-chg-blacklist.conf \
		"$pkgdir"/usr/lib/modprobe.d/oplus-chg.conf
	install -Dm644 "$srcdir"/oplus-chg-modules-load.conf \
		"$pkgdir"/usr/lib/modules-load.d/oplus-chg.conf
}

_pulseaudio() {
	pkgdesc="$pkgdesc: PulseAudio on AudioReach PAL"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio-backend-pulseaudio"
	depends="audioreach-pulseaudio-plugin"
	amove etc/pulse usr/bin/senna-voice-volume
}

_pipewire() {
	pkgdesc="$pkgdesc: PipeWire on AudioReach PAL (voice calls through callaudiod)"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio-backend-pipewire"
	depends="audioreach-pipewire-plugin"
	amove usr/share/pipewire usr/share/wireplumber
}

