# Maintainer: japq7s <japiotr123@proton.me>
# Kernel: Linux 7.3 from Xlie-Electronic-Customs/linux master
# + realme GT Neo5 150W (senna-b) patches, branch "senna-xlie" of
# https://github.com/japq7s/linux-sm8450-mainline
# Devices: Realme GT Neo5 150W (senna-b)

_flavor="postmarketos-qcom-sm8450"
pkgname=linux-$_flavor
pkgver=7.3.0
pkgrel=6
pkgdesc="Mainline kernel fork for SM8450/SM8475 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/japq7s/linux-sm8450-mainline"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-iwd
	pmb:kconfigcheck-nftables
	"
makedepends="bison findutils flex installkernel openssl-dev perl python3"

_commit="a21a0f06e3e00d772352613cde8c06e3eda7b603"
_config="config-$_flavor.$arch"
# AudioReach kernel drivers (GPR passthrough, audio memory, q6apm/q6prm for
# the AudioReach userspace). They replace the upstream q6apm/q6prm ASoC
# drivers, which device-realme-senna-b blacklists.
_ar_commit="07e619c32b8a63a9a0ea7cf23438b3d5f62f0baf"
# OPLUS charger (oplus_chg v1) for the realme GT Neo5 150W (senna-b): the OPLUS
# ADSP charger firmware does not charge until this driver enables it.
# device-realme-senna-b blacklists qcom_battmgr, which binds the same service.
_oc_commit="ceb21e7eb42b40786eed69f99118ed93bd918058"

source="
	$pkgname-$_commit.tar.gz::https://github.com/japq7s/linux-sm8450-mainline/archive/$_commit.tar.gz
	config-$_flavor.$arch
	audioreach-kernel-$_ar_commit.tar.gz::https://github.com/Audioreach/audioreach-kernel/archive/$_ar_commit.tar.gz
	0001-audioreach-kernel-sm8450-drop-WSA-speaker-and-jack-defaults.patch
	0002-audioreach-kernel-audio_pkt-full-32-bit-tokens.patch
	oplus-chg-$_oc_commit.tar.gz::https://github.com/japq7s/oplus-chg-mainline/archive/$_oc_commit.tar.gz
"
builddir="$srcdir/linux-sm8450-mainline-$_commit"
_ardir="$srcdir/audioreach-kernel-$_ar_commit"
_ocdir="$srcdir/oplus-chg-mainline-$_oc_commit"

prepare() {
	# the patches are for audioreach-kernel, not for the kernel tree
	cd "$_ardir"
	patch -p1 -i "$srcdir"/0001-audioreach-kernel-sm8450-drop-WSA-speaker-and-jack-defaults.patch
	patch -p1 -i "$srcdir"/0002-audioreach-kernel-audio_pkt-full-32-bit-tokens.patch

	cd "$builddir"
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"

	make ARCH="$_carch" CC="${CC:-gcc}" \
		M="$_ardir/audioreach-driver" KERNEL_SRC="$builddir" VENDOR_QCOM=1 \
		modules

	KSRC="$builddir" "$_ocdir"/build-mainline.sh CC="${CC:-gcc}" modules
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	make ARCH="$_carch" \
		M="$_ardir/audioreach-driver" KERNEL_SRC="$builddir" VENDOR_QCOM=1 \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1 INSTALL_MOD_DIR=extra \
		modules_install

	KSRC="$builddir" "$_ocdir"/build-mainline.sh \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1 INSTALL_MOD_DIR=extra \
		modules_install

	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="
